generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(cuid())
  clerkId              String?                @unique
  email                String                 @unique
  name                 String?
  password             String?
  emailVerified        Boolean                @default(false)
  role                 Role                   @default(STUDENT)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  needsPasswordChange  Boolean                @default(false)
  isActive             Boolean                @default(true)
  studentId            String?                @unique
  hasSeenWelcome       Boolean                @default(false)
  hasSeenTour          Boolean                @default(false)
  image                String?                // Profile picture URL
  assignmentsSubmitted AssignmentSubmission[]
  assessmentSubmissions AssessmentSubmission[]
  cohortEnrollments    CohortEnrollment[]
  drafts               CourseDraft[]          @relation("CreatorDrafts")
  coursesCreated       CreatorCourse[]        @relation("CreatorToCourse")
  creatorProfile       CreatorProfile?
  emailVerifications   EmailVerification[]
  enrollments          Enrollment[]           @relation("StudentEnrollments")
  purchases            Purchase[]
  sessions             Session[]
  tutorProfile         TutorProfile?
  managedCohorts       Cohort[]               @relation("CohortTutors")
  classroomMessages    ClassroomMessage[]
  attendanceRecords    AttendanceRecord[]
  classroomStatuses    StudentClassroomStatus[]
  mentionedIn          ClassroomMessage[]     @relation("MessageMentions")
  liveSessions         LiveSession[]
  notifications        Notification[]
  classroomReactions   MessageReaction[]
  liveSessionMessages  LiveSessionMessage[]
}

model CreatorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  specialty String?
  website   String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TutorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  specialty     String?
  bio           String?
  avatarUrl     String?
  linkedinUrl   String?
  coursesTaught String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  otp       String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String?  @unique
  content    String
  excerpt    String?
  image      String?
  tag        String?
  author     String?
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Staging area — creator edits before submitting for review
model CourseDraft {
  id          String       @id @default(cuid())
  title       String?
  description String?
  price       Float?
  thumbnail   String?
  zipFileUrl  String?
  creatorId   String
  status      DraftStatus  @default(EDITING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creator     User         @relation("CreatorDrafts", fields: [creatorId], references: [id])
  videos      DraftVideo[]
}

/// Individual video staged inside a draft
model DraftVideo {
  id          String      @id @default(cuid())
  draftId     String
  title       String
  description String?
  order       Int
  fileName    String
  fileUrl     String?
  isFree      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  draft       CourseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

/// Published course (PENDING → APPROVED → live on catalog)
model CreatorCourse {
  id          String        @id @default(cuid())
  title       String
  description String
  price       Float
  status      CourseStatus  @default(PENDING)
  thumbnail   String?
  draftId     String?
  creatorId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  videos      CourseVideo[]
  creator     User          @relation("CreatorToCourse", fields: [creatorId], references: [id])
  enrollments Enrollment[]  @relation("CourseEnrollments")
  purchases   Purchase[]
}

/// Ordered video in a published course
model CourseVideo {
  id          String          @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  fileUrl     String
  isFree      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  course      CreatorCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    VideoProgress[]
}

model Purchase {
  id        String        @id @default(cuid())
  userId    String
  courseId  String
  amount    Float
  reference String?       @unique
  createdAt DateTime      @default(now())
  course    CreatorCourse @relation(fields: [courseId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
}

/// One enrollment = one student's private classroom instance for a course
model Enrollment {
  id          String          @id @default(cuid())
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  course      CreatorCourse   @relation("CourseEnrollments", fields: [courseId], references: [id])
  user        User            @relation("StudentEnrollments", fields: [userId], references: [id])
  progress    VideoProgress[]

  @@unique([userId, courseId])
}

/// Per-video watch progress within an enrollment
model VideoProgress {
  id            String      @id @default(cuid())
  enrollmentId  String
  videoId       String
  progressSec   Int         @default(0)
  completed     Boolean     @default(false)
  lastWatchedAt DateTime?
  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  video         CourseVideo @relation(fields: [videoId], references: [id])

  @@unique([enrollmentId, videoId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?   // The recipient of the notification
  type      String    // e.g. "BROADCAST", "ASSIGNMENT", "SYSTEM"
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcademyCourse {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  thumbnail        String?
  level            String   @default("Beginner")
  duration         String   @default("8 Weeks")
  price            String   @default("NGN5,000")
  isProgramming    Boolean  @default(false)
  instructorName   String?
  instructorAvatar String?
  instructorRole   String?
  color            String   @default("from-blue-600 to-indigo-600")
  buttonColor      String   @default("bg-white text-blue-600")
  modules          Json?
  basePrice        Float    @default(50000)
  isActive         Boolean  @default(true)
  gradient         String   @default("from-indigo-600 via-purple-600 to-pink-600")
  outcomes         Json?
  requirements     Json?
  tag              String   @default("Engineering")
  cohorts          Cohort[]
}

model Cohort {
  id                 String             @id @default(cuid())
  name               String
  courseId           String
  startDate          DateTime?
  endDate            DateTime?
  maxStudents        Int                @default(20)
  partPaymentEnabled Boolean            @default(true)
  partPaymentPercent Int                @default(50)
  createdAt          DateTime           @default(now())
  isActive           Boolean            @default(true)
  assignments        Assignment[]
  course             AcademyCourse      @relation(fields: [courseId], references: [id])
  enrollments        CohortEnrollment[]
  tutors             User[]             @relation("CohortTutors")
  settings           ClassroomSettings?
  messages           ClassroomMessage[]
  attendanceSessions AttendanceSession[]
  studentStatuses    StudentClassroomStatus[]
  isLive             Boolean                @default(false)
  liveRoomId         String?
  assessments        Assessment[]
  liveSessions       LiveSession[]
}

model LiveSession {
  id          String   @id @default(cuid())
  cohortId    String
  title       String
  description String?
  scheduledAt DateTime
  isStarted   Boolean  @default(false)
  isEnded     Boolean  @default(false)
  createdAt   DateTime @default(now())
  tutorId     String
  participantCount Int @default(0)
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  tutor       User     @relation(fields: [tutorId], references: [id])
  messages    LiveSessionMessage[]
}

model CohortEnrollment {
  id            String               @id @default(cuid())
  userId        String
  cohortId      String
  totalAmount   Float                @default(0)
  amountPaid    Float                @default(0)
  paymentStatus AcademyPaymentStatus @default(UNPAID)
  reference     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  cohort        Cohort               @relation(fields: [cohortId], references: [id])
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
}

model Assignment {
  id          String                 @id @default(cuid())
  title       String
  description String
  cohortId    String
  dueAt       DateTime?
  maxScore    Float                  @default(100)
  isOpen      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  cohort      Cohort                 @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id          String     @id @default(cuid())
  assignmentId String
  userId      String
  fileUrl     String?
  content     String?    // text submission
  score       Float?
  grade       String?
  feedback    String?
  submittedAt DateTime   @default(now())
  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
}

/// Per-cohort classroom configuration set by the tutor
model ClassroomSettings {
  id                   String   @id @default(cuid())
  cohortId             String   @unique
  welcomeNote          String?  // markdown welcome message shown on first entry
  rules                String?  // markdown rules & expectations
  passThreshold        Float    @default(70)  // minimum % to earn certificate
  attendanceWeight     Float    @default(30)  // % of total score
  assignmentWeight     Float    @default(50)
  participationWeight  Float    @default(20)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  cohort               Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
}

/// Chat messages inside a classroom
model ClassroomMessage {
  id        String   @id @default(cuid())
  cohortId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  mentions  User[]   @relation("MessageMentions")
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  reactions MessageReaction[]
}

/// A tutor-opened attendance window
model AttendanceSession {
  id        String              @id @default(cuid())
  cohortId  String
  openedAt  DateTime            @default(now())
  closedAt  DateTime?
  label     String?             // e.g. "Week 3 - Live Session"
  cohort    Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  records   AttendanceRecord[]
}

/// A single student's check-in for one session
model AttendanceRecord {
  id          String            @id @default(cuid())
  sessionId   String
  userId      String
  checkedInAt DateTime          @default(now())
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

/// Tutor can suspend or kick a student from a classroom
model StudentClassroomStatus {
  id        String              @id @default(cuid())
  cohortId  String
  userId    String
  status    ClassroomUserStatus @default(ACTIVE)
  reason    String?
  updatedAt DateTime            @updatedAt
  cohort    Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@unique([cohortId, userId])
}

enum Role {
  STUDENT
  ADMIN
  TUTOR
  CREATOR
}

enum DraftStatus {
  EDITING
  SUBMITTED
}

enum CourseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AcademyPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ClassroomUserStatus {
  ACTIVE
  SUSPENDED
  KICKED
}

model PendingStudent {
  id            String   @id @default(cuid())
  email         String   @unique
  studentId     String   @unique
  cohortId      String
  paymentStatus String   @default("PAID")
  amountPaid    Float
  createdAt     DateTime @default(now())
}
model Assessment {
  id          String   @id @default(cuid())
  title       String
  description String
  cohortId    String
  dueAt       DateTime?
  maxScore    Float    @default(100)
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  submissions AssessmentSubmission[]
}

model AssessmentSubmission {
  id           String     @id @default(cuid())
  assessmentId String
  userId       String
  content      String?    // text or link to result
  score        Float?
  feedback     String?
  submittedAt  DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([assessmentId, userId])
}

model LiveSessionMessage {
  id            String      @id @default(cuid())
  sessionId     String
  userId        String
  content       String
  createdAt     DateTime    @default(now())
  session       LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])
  reactions     MessageReaction[]
}

model MessageReaction {
  id          String   @id @default(cuid())
  emoji       String   // e.g. "👍"
  userId      String
  messageId   String?  // Relation to main classroom message
  liveMsgId   String?  // Relation to live session message
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  message     ClassroomMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  liveMessage LiveSessionMessage? @relation(fields: [liveMsgId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@unique([userId, liveMsgId, emoji])
}
